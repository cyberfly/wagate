{
  "name": "wagate",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && tsc -p sidecar/tsconfig.json --noEmit",
    "test": "bun test sidecar/test",
    "sidecar:dev": "bun sidecar/src/index.ts",
    "sidecar:build": "bun scripts/build-sidecar.ts",
    "desktop:dev": "bun run sidecar:build && tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "preview:ui": "vite --host 127.0.0.1 --mode preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "hono": "^4.12.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
